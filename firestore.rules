rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Correos con privilegios administrativos en Firestore (contenido, usuarios, etc.)
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email == "sistemas.ti@bacarsa.com.ar"
          || request.auth.token.email == "admin@bacarsa.com.ar"
        );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function canManageUsers() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.super_admin == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.manage_users == true
        );
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.super_admin == true;
    }

    // Admin de área (role explícito). Necesita listar users para asignar carpetas (Fase 2).
    function isAreaAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function callerManagedAreaIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedAreaIds;
    }

    function isAreaAdminOf(areaId) {
      return isAreaAdmin()
        && areaId is string
        && callerManagedAreaIds() is list
        && areaId in callerManagedAreaIds();
    }

    function onlySelfPreferencesUpdate() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['favoriteApps'])
        || keys.hasOnly(['widgetPreferences'])
        || keys.hasOnly(['favoriteApps', 'widgetPreferences']);
    }

    // managedAreaIds, memberAreaIds y actionGrants solo vía Admin SDK (backend super_admin).
    function userGovernanceFieldsUnchanged() {
      let before = resource.data;
      let after = request.resource.data;
      return after.get('managedAreaIds', null) == before.get('managedAreaIds', null)
        && after.get('memberAreaIds', null) == before.get('memberAreaIds', null)
        && after.get('actionGrants', null) == before.get('actionGrants', null);
    }

    function auditLogCreateValid() {
      return request.resource.data.keys().hasAll([
        'userId',
        'userEmail',
        'action',
        'targetType',
        'targetId',
        'targetName',
        'parentFolderId',
        'mimeType',
        'reason',
        'metadata',
        'createdAt',
      ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail is string
        && request.resource.data.action is string
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.targetName is string
        && (request.resource.data.parentFolderId is string || request.resource.data.parentFolderId == null)
        && (request.resource.data.mimeType is string || request.resource.data.mimeType == null)
        && (request.resource.data.reason is string || request.resource.data.reason == null)
        && request.resource.data.metadata is map
        && request.resource.data.createdAt is timestamp;
    }

    // Append-only. Lectura: super_admin (panel). Escritura cliente: intranet actual.
    // Pasos 3–5: acciones sobre Drive las escribe el backend con Admin SDK (no pasan por rules).
    // En ese momento hay que restringir create de cliente a acciones que no sean Drive
    // (o denegar create de cliente y dejar solo Admin SDK).
    match /auditLogs/{document} {
      allow create: if isAuthenticated() && auditLogCreateValid();
      allow get, list: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Perfiles de usuario y permisos
    // get: propio doc, o Super Admin / Admin de área / emails hardcodeados
    // list: solo Super Admin / Admin de área / emails hardcodeados (no usuarios comunes)
    match /users/{userId} {
      allow get: if isAuthenticated()
        && (
          request.auth.uid == userId
          || isSuperAdmin()
          || isAreaAdmin()
          || isAdmin()
        );
      allow list: if isSuperAdmin() || isAreaAdmin() || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if userGovernanceFieldsUnchanged()
        && (
          canManageUsers() || isAdmin()
          || (isAuthenticated() && request.auth.uid == userId && onlySelfPreferencesUpdate())
        );
      allow delete: if canManageUsers() || isAdmin();
    }

    // Noticias / comunicados
    match /news/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Enlaces útiles
    match /links/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Aplicaciones internas del dashboard (solo Super Admin)
    match /coreApps/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // Directorio de contactos — lectura solo autenticados
    match /contacts/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // Configuración previa al primer login (solo super_admin)
    match /pendingUserSetup/{email} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    // Colección legacy (intranet antigua). Sin uso activo; solo Admin SDK si hiciera falta.
    match /sharedFiles/{document} {
      allow read, create, update, delete: if false;
    }

    function onlyPollVotesUpdate() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
    }

    // Encuestas rápidas
    match /polls/{document} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && onlyPollVotesUpdate());
    }

    // Pregunta del día (una por fecha)
    match /dailyQuestions/{document} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && onlyPollVotesUpdate());
    }

    // Reconocimientos (kudos)
    match /kudos/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Banners / popups
    match /banners/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Catálogo de áreas gobernantes (solo raíces). Escritura vía Admin SDK / scripts.
    match /folders/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Sidecar de intranet por archivo de Drive (classification, etc.).
    // Escritura solo Admin SDK (backend). Lectura: autenticados (badge en UI).
    match /driveFiles/{fileId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Mapeo carpeta Drive de primer nivel → área intranet. Solo Admin SDK.
    match /driveFolderAreas/{driveTopLevelFolderId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Colección legacy (intranet antigua). Solo lectura denegada; purge vía Admin SDK.
    match /resourceItems/{document} {
      allow read, create, update, delete: if false;
    }

    // Configuración global de módulos
    match /global_settings/{document} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isSuperAdmin();
    }

    // Turnos — jefe manual por semana (lunes a domingo)
    match /shiftJefeAssignments/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Rotación de Sistemas y excepciones puntuales
    match /shift_settings/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /shiftSystemsOverrides/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
