@echo off
setlocal EnableExtensions
REM Borra backend\node_modules en PC-N8N aunque haya bucles intranet1 / MAX_PATH.
REM Ejecutar CMD como Administrador. Antes: pm2 stop bacarnet-emulators

cd /d D:\App\Bacarnet\backend
if not exist node_modules (
  echo node_modules no existe, nada que borrar.
  exit /b 0
)

set TRASH=node_modules._trash_%RANDOM%

echo [1/4] Renombrar node_modules -^> %TRASH% ...
ren node_modules %TRASH%
if exist node_modules (
  echo Renombrar fallo, sigo con borrado in-place...
  set TRASH=node_modules
) else (
  echo OK renombrado. npm install puede usar carpeta node_modules nueva.
)

if not "%TRASH%"=="node_modules" (
  if exist "%TRASH%" goto :delete_trash
  if not exist node_modules (
    echo Listo. Ya podes: npm install
    exit /b 0
  )
)

:delete_inplace
echo [2/4] robocopy espejo vacio (no usar Remove-Item: cuelga en arboles intranet1)...
mkdir empty_wipe_dir 2>nul
robocopy empty_wipe_dir node_modules /MIR /R:0 /W:0 /NFL /NDL /NJH /NJS
rmdir /s /q node_modules 2>nul
rmdir empty_wipe_dir 2>nul
goto :done

:delete_trash
mkdir empty_wipe_dir 2>nul
robocopy empty_wipe_dir "%TRASH%" /MIR /R:0 /W:0 /NFL /NDL /NJH /NJS
powershell -NoProfile -Command ^
  "$p='\\?\D:\App\Bacarnet\backend\%TRASH%'; if (Test-Path -LiteralPath $p) { Remove-Item -LiteralPath $p -Recurse -Force -ErrorAction SilentlyContinue }"
rmdir /s /q "%TRASH%" 2>nul
rmdir empty_wipe_dir 2>nul

:done
if exist node_modules (
  echo.
  echo AUN queda node_modules. Reinicia PC-N8N, pm2 stop, vuelve a ejecutar este script.
  echo Mientras tanto: ren node_modules node_modules.old ^& mkdir node_modules ^& npm install
  exit /b 1
)
echo node_modules eliminado.
exit /b 0
